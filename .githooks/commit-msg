#!/usr/bin/env bash
set -euo pipefail

MSG_FILE="$1"

# Reject injected co-author trailers from tooling.
sed -i -E '/^Co-authored-by:/Id' "$MSG_FILE"
sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$MSG_FILE"

if grep -qiE '^Co-authored-by:' "$MSG_FILE"; then
  echo "commit blocked: Co-authored-by trailers are not allowed" >&2
  exit 1
fi
